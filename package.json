{
  "name": "sunset-rush",
  "private": true,
  "version": "0.2.0",
  "description": "Sunset Rush — a polished 3D arcade racing adventure (Vite + TypeScript + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "@pmndrs/assets": "1.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.50.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
